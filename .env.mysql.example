# 阿里云 MySQL 8.0 配置
# 请将此文件复制为 .env.local 并填写实际值

# MySQL 数据库主机地址
# 格式: rm-xxx.mysql.rds.aliyuncs.com
MYSQL_HOST=your-mysql-host.mysql.rds.aliyuncs.com

# MySQL 端口（默认 3306）
MYSQL_PORT=3306

# MySQL 用户名
MYSQL_USER=your_username

# MySQL 密码
MYSQL_PASSWORD=your_password

# MySQL 数据库名
MYSQL_DATABASE=zhaoSheng
